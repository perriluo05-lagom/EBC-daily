# EBC Daily 本地测试环境变量样例
# 复制为 .env 并填入真实值后再运行;生产环境改用 GitHub Secrets

# QQ 邮箱 SMTP
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=your_qq@qq.com
MAIL_PASS=your_qq_authorization_code
MAIL_FROM=your_qq@qq.com

# 收件人(多个用英文逗号分隔)
MAIL_TO=somebody@example.com

# 可选:强制指定报告日期 YYYY-MM-DD(留空取今天)
FORCE_DATE=

# LLM 智能解读(Groq 免费 LLM API,OpenAI 兼容)
# 在 https://console.groq.com/keys 创建 key(gsk_ 开头)
# 不配置则自动回退规则版解读,流程不中断
LLM_API_KEY=
# 可选:覆盖默认端点(默认 https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1
# 可选:覆盖默认模型(默认 llama-3.3-70b-versatile;中文可切 qwen/qwen3-32b)
LLM_MODEL=llama-3.3-70b-versatile
